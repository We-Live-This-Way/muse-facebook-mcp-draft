# Facebook app credentials (from developers.facebook.com)
FB_APP_ID=your-app-id
FB_APP_SECRET=your-app-secret

# The Facebook Page this server is allowed to work with
FB_PAGE_ID=your-page-id

# Never-expiring Page access token (used for Page reads and draft writes)
FB_PAGE_TOKEN=your-page-access-token

# Long-lived user token (~60 days; used for Meta Ad Library search)
FB_LONG_TOKEN=your-long-lived-user-token

# Optional. Short-lived user token, kept for reference only; not required at runtime.
# FB_SHORT_TOKEN=your-short-lived-user-token
